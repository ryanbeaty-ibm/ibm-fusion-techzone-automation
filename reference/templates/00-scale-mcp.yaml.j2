# DRAFT: A custom MachineConfigPool for the three selected Scale nodes.
# This pool inherits worker MachineConfigs, but excludes Ceph nodes from Scale-specific changes.
apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfigPool
metadata:
  name: scale
spec:
  machineConfigSelector:
    matchExpressions:
      - key: machineconfiguration.openshift.io/role
        operator: In
        values:
          - worker
          - scale
  nodeSelector:
    matchLabels:
      node-role.kubernetes.io/scale: ""
