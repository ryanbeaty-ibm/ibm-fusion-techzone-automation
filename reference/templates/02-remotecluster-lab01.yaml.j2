apiVersion: scale.spectrum.ibm.com/v1beta1
kind: RemoteCluster
metadata:
  name: {{ scale_name }}
  namespace: {{ scale_namespace }}
spec:
  gui:
    hosts:
      - '{{ scale_management_host }}'
    port: {{ scale_management_port }}
    scheme: https
    secretName: {{ scale_gui_secret_name }}
    insecureSkipVerify: {{ 'true' if scale_insecure_skip_verify else 'false' }}
