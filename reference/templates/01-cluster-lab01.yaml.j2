# IBM Fusion Lab 01 — local data-access client for PRE-DEPLOYED external Scale server.
# This does NOT configure or alter the remote storage server.
apiVersion: scale.spectrum.ibm.com/v1beta1
kind: Cluster
metadata:
  name: ibm-spectrum-scale
  namespace: {{ scale_namespace }}
spec:
  license:
    accept: true
    license: {{ scale_license }}
  daemon:
    nodeSelector:
      node-role.kubernetes.io/scale: ''
    resources:
      requests:
        cpu: '2'
        memory: 6Gi
